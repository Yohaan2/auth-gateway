# ============================================================
# AUTH MANAGER — Variables de entorno
# Copia este archivo como .env y rellena los valores.
# Genera secretos con: openssl rand -hex 32
# ============================================================

# ==========================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==========================================
PORT=3000
NODE_ENV=production
APP_URL=https://auth.optrax.io
FRONTEND_URL=https://auth.optrax.io

# Secretos de sesión (express-session). Mínimo 32 caracteres en producción.
SESSION_SECRET=<generar-con-openssl-rand-hex-32>

# Bootstrap del primer admin del panel (solo desarrollo / primer arranque controlado)
ENABLE_ADMIN_BOOTSTRAP=false

# Clientes OIDC autorizados para la API administrativa (lista separada por comas)
KEYCLOAK_ALLOWED_CLIENT_IDS=optrax-frontend

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (POSTGRES)
# ==========================================
# En Docker el host es el nombre del servicio: postgres
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/auth_optrax
DB_HOST=postgres
DB_PORT=5432
DB_USER=<POSTGRES_USER>
DB_PASSWORD=<POSTGRES_PASSWORD>
DB_NAME=auth_optrax

POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=auth_optrax
KC_POSTGRES_DB=keycloak

KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=<POSTGRES_USER>
KC_DB_PASSWORD=<POSTGRES_PASSWORD>

# postgres-exporter (profile monitoring)
DATA_SOURCE_NAME=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/auth_optrax?sslmode=disable

# ==========================================
# CONFIGURACIÓN DE KEYCLOAK
# ==========================================
# URL pública (navegador / issuer JWT). En Docker usar KEYCLOAK_INTERNAL_URL para el backend.
KEYCLOAK_URL=https://auth.optrax.io/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth

KEYCLOAK_REALM=optrax-realm

# Client confidencial (flujo legacy de sesión en Express)
KEYCLOAK_CLIENT_ID=optrax-app
KEYCLOAK_CLIENT_SECRET=<minimo-32-caracteres-optrax-app>
KEYCLOAK_REDIRECT_URI=https://auth.optrax.io/api/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://auth.optrax.io/

# Consola master de Keycloak (primer arranque del contenedor)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<generar>

# Service Account — Admin REST API (client auth-manager-sa + realm-management)
KEYCLOAK_SA_CLIENT_ID=auth-manager-sa
KEYCLOAK_SA_CLIENT_SECRET=<minimo-32-caracteres-auth-manager-sa>

# Roles IAM del panel (realm roles en Keycloak)
KEYCLOAK_ADMIN_ROLE=SUPER_ADMIN
KEYCLOAK_VIEWER_ROLE=AUDITOR

# ==========================================
# FRONTEND (Vite — incrustadas al construir la imagen Docker)
# ==========================================
VITE_KEYCLOAK_URL=https://auth.optrax.io/auth
VITE_KEYCLOAK_REALM=optrax-realm
VITE_KEYCLOAK_CLIENT_ID=optrax-frontend
VITE_ADMIN_ROLE=SUPER_ADMIN
VITE_VIEWER_ROLE=AUDITOR

# ==========================================
# OBSERVABILIDAD (opcional)
# ==========================================
OTEL_SERVICE_NAME=auth
OTEL_EXPORTER_OTLP_ENDPOINT=http://<host-colector>:4317
OTEL_LOG_LEVEL=info

# ==========================================
# DESARROLLO LOCAL (sin Docker / npm run dev)
# ==========================================
# NODE_ENV=development
# APP_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000
# KEYCLOAK_URL=http://localhost:8080/auth
# KEYCLOAK_INTERNAL_URL=http://localhost:8080/auth
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_optrax
# KEYCLOAK_CLIENT_ID=auth-manager
# KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/callback
# VITE_KEYCLOAK_URL=http://localhost:8080/auth

# ==========================================
# DESPLIEGUE SIN DOMINIO (solo IP, HTTP, puerto 80)
# Guía: DESPLIEGUE_SIN_DOMINIO.md
# Compose: -f docker/docker-compose.yml -f docker/docker-compose.no-domain.yml
# Sustituye 203.0.113.10 por la IP pública en estas URLs (no cambies postgres/keycloak internos):
# APP_URL=http://203.0.113.10
# FRONTEND_URL=http://203.0.113.10
# KEYCLOAK_URL=http://203.0.113.10/auth
# KEYCLOAK_REDIRECT_URI=http://203.0.113.10/api/auth/callback
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://203.0.113.10/
# VITE_KEYCLOAK_URL=http://203.0.113.10/auth
# Tras editar: node docker/prepare-realm.cjs .env && rebuild imagen app

# ==========================================
# DESPLIEGUE EN SERVIDOR (Git / DigitalOcean — opcional)
# ==========================================
# DO_HOST=
# DO_USER=
# DO_PASSWORD=
# DO_PORT=22
# GIT_USER=
# GIT_TOKEN=
