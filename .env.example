# ==========================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==========================================
PORT=3000
NODE_ENV=production
# Dominio público (solo el host). Lo usan nginx (server_name) y, con las URLs de abajo, Keycloak.
# Para cambiar de dominio: DOMAIN + las URLs https://<DOMAIN>... (ver DESPLIEGUE_SIN_DOMINIO.md §8).
DOMAIN=auth.optrax.io
APP_URL=https://auth.optrax.io
FRONTEND_URL=https://auth.optrax.io


SESSION_SECRET='changeme-session-secret-minimo-32-caracteres'

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (POSTGRES)
# ==========================================
DATABASE_URL=postgresql://user_auth:changeme-postgres-password@postgres:5432/auth_optrax
DB_HOST=postgres
DB_PORT=5432
POSTGRES_USER=user_auth
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=auth_optrax
KC_POSTGRES_DB=keycloak

KC_DB_URL='jdbc:postgresql://postgres:5432/keycloak'
KC_DB_USERNAME=user_auth
KC_DB_PASSWORD=changeme-postgres-password

# ==========================================
# CONFIGURACIÓN DE KEYCLOAK
# ==========================================
KEYCLOAK_URL=https://auth.optrax.io/auth
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth

KEYCLOAK_REALM=optrax-realm


KEYCLOAK_CLIENT_ID=optrax-app
KEYCLOAK_CLIENT_SECRET=changeme-optrax-app-client-secret-32
KEYCLOAK_REDIRECT_URI=https://auth.optrax.io/api/auth/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://auth.optrax.io/


KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-keycloak-master-password


KEYCLOAK_SA_CLIENT_ID=auth-manager-sa
KEYCLOAK_SA_CLIENT_SECRET=changeme-auth-manager-sa-secret-32


KEYCLOAK_ADMIN_ROLE=SUPER_ADMIN
KEYCLOAK_VIEWER_ROLE=AUDITOR


OTEL_SERVICE_NAME=auth
OTEL_EXPORTER_OTLP_ENDPOINT=http://changeme-otel-host:4317
OTEL_LOG_LEVEL=info

DATA_SOURCE_NAME="postgresql://user_auth:changeme-postgres-password@postgres:5432/auth_optrax?sslmode=disable"
